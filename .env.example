# Google AI Studio key for Mastra + Gemini 3.8 Flash. Without it, the clearly labeled
# local demo intent parser can run the exact payment demo without an LLM.
GOOGLE_API_KEY=
MODEL_ID=google/gemini-3.8-flash

# Optional Stripe TEST secret key only (sk_test_...). Keep this server-side.
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd
CLASP_DEMO_MERCHANT_ID=clasp_demo_merchant

PORT=4173
SESSION_TTL_SECONDS=120
MAX_TEST_PAYMENT_CENTS=500
