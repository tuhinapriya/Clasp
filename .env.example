# Google AI Studio key for Mastra + Gemini 3.8 Flash. Without it, payment requests fail closed.
GOOGLE_API_KEY=
MODEL_ID=google/gemini-3.8-flash

# Optional Stripe TEST secret key only (sk_test_...). Keep this server-side.
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd
CLASP_DEMO_MERCHANT_ID=clasp_demo_merchant

PORT=4173
# Default is fail-closed real biometric mode. Opt into a clearly labeled test-only simulation explicitly.
CLASP_IDENTITY_MODE=biometric
SESSION_TTL_SECONDS=120
MAX_TEST_PAYMENT_CENTS=500

# Optional local Polar worker settings. Point to the official Pulse-PPG source and checkpoint.
# CLASP_PULSEPPG_SOURCE=/absolute/path/to/pulseppg
# CLASP_PULSEPPG_CHECKPOINT=/absolute/path/to/checkpoint_best.pkl
# CLASP_PPG_PROFILE=/absolute/path/to/primary-user-ppg.json
# CLASP_PPG_PYTHON=/absolute/path/to/clasp-ppg/.venv/bin/python
# CLASP_PPG_DEVICE=Polar device identifier

# Pulse-PPG remains UNCERTAIN until independently calibrated; old thresholds are ignored.
# CLASP_PPG_DIAGNOSTICS=1             # Opt in; raw biometric data stays local.
# CLASP_PPG_TEST_WEARER=person_a      # Required for live diagnostic recording.
# CLASP_PPG_DIAGNOSTICS_DIR=/absolute/private/path
