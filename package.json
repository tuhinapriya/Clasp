{
  "name": "clasp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts && .venv/bin/python -m unittest discover -s test_py",
    "check": "tsc --noEmit",
    "demo": "node scripts/demo.mjs",
    "setup:vexo": "python3 -m venv .venv && .venv/bin/python -m pip install \"bleak>=0.21\"",
    "setup:voice": ".venv/bin/python -m pip install \"av>=16,<17\" \"speechbrain>=1.1,<2\" \"mlx-whisper>=0.4,<1\""
  },
  "dependencies": {
    "@mastra/core": "latest",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "stripe": "^20.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
